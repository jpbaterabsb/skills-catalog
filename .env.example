# Copy to .env (git-ignored) to run the agentic eval:
#   uv run --group eval python -m tests.eval.agentic
# Only the agentic eval calls the Claude API; everything else runs without credentials.

# Claude API key (https://platform.claude.com). Leave empty to use an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown).
SKILLS_EVAL_AGENT_MODEL=claude-haiku-5-5
SKILLS_EVAL_JUDGE_MODEL=claude-opus-5-5
